{
  "settings": {
    "autoAuth": false,
    "directTools": false,
    "hostConfigDiscovery": "off",
    "sampling": false
  },
  "mcpServers": {
    "kling-ai": {
      "url": "https://kling.ai/mcp/plugin",
      "auth": "oauth",
      "oauth": {
        "clientName": "Plugin-Pi",
        "scope": "generation.create generation.read account.credit.read"
      },
      "headers": {
        "X-Kling-Integration": "Plugin-Pi"
      },
      "lifecycle": "lazy"
    }
  }
}
