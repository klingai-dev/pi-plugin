{
  "name": "kling-ai-pi",
  "version": "1.0.6",
  "type": "module",
  "description": "Kling AI package for Pi with OAuth, MCP Apps, and China/Global regions",
  "license": "MIT",
  "author": "KLING AI Pte Ltd",
  "homepage": "https://kling.ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klingai-dev/pi-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/klingai-dev/pi-plugin/issues"
  },
  "keywords": [
    "pi-package",
    "kling-ai",
    "mcp",
    "image-generation",
    "video-generation"
  ],
  "scripts": {
    "check": "node scripts/check.mjs && npm run typecheck",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "pi-mcp-adapter": "2.27.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "files": [
    "LICENSE",
    "README.md",
    "docs/RELEASE_CHECKLIST.md",
    "extensions",
    "mcp.china.json",
    "mcp.global.json",
    "scripts/check.mjs",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./extensions/kling-ai.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
